# Local: đường dẫn tới file JSON. Render: /etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=D:\duong-dan\firebase-service-account.json

# Gmail SMTP: dùng App Password 16 ký tự, không dùng mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com

# Chuỗi bí mật ngẫu nhiên dài ít nhất 16 ký tự để băm OTP.
OTP_SECRET=replace-with-a-long-random-secret
